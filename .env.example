DATABASE_URL=postgresql+asyncpg://fastapi_user:secret123@localhost:5432/fastapi_db
# Only needed to run the test suite; leave unset in production.
TEST_DATABASE_URL=postgresql+asyncpg://fastapi_user:secret123@localhost:5432/fastapi_db_test
# Connections kept open per worker process. DB_POOL_SIZE + DB_MAX_OVERFLOW,
# multiplied by the number of worker processes, must stay under PostgreSQL's
# max_connections.
DB_POOL_SIZE=5
# Extra connections opened past DB_POOL_SIZE under load, then closed again.
DB_MAX_OVERFLOW=10
# Seconds a pooled connection may live before it's recycled, so it never
# survives a database-side idle timeout and comes back stale.
DB_POOL_RECYCLE=1800
# The app refuses to start while SECRET_KEY is still this placeholder.
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-to-a-random-32-byte-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh tokens are stored hashed and revoked by logout, password change and
# deactivation; this bounds a stolen one that nobody has revoked yet.
REFRESH_TOKEN_EXPIRE_DAYS=7
# How long a borrowed session lasts. It comes with no refresh token, so this is
# the whole of it.
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30

# development serves /docs and skips HSTS; staging and production skip /docs
# and send HSTS unless DOCS_ENABLED/HSTS_ENABLED override it below.
ENVIRONMENT=development
# Serve /docs, /redoc and /openapi.json. Leave unset to follow ENVIRONMENT
# (on outside production, off in production).
# DOCS_ENABLED=true
# Browser origins allowed to call the API, comma separated. Leave empty when
# the frontend and /api share one origin behind a proxy. Never "*".
CORS_ORIGINS=
# Largest request body the API reads, in bytes. Anything above answers 413. It
# has to stay above MAX_ATTACHMENT_BYTES, or an upload the attachment limit
# allows would be cut off before the route saw it; the app refuses to start
# otherwise.
MAX_REQUEST_BODY_BYTES=8388608
# Send Strict-Transport-Security. Leave unset to follow ENVIRONMENT (off
# outside production, on in production). Set explicitly once TLS terminates
# in front of the app.
# HSTS_ENABLED=false
# Where the rate limiter counts. Empty keeps the count in this process, which
# is wrong the moment a second replica answers: each one would allow the whole
# limit on its own. Point it at redis://host:6379 before scaling out.
RATE_LIMIT_STORAGE_URI=
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
# Guards every endpoint that can make this service send mail.
MAIL_RATE_LIMIT=5/hour

# Where the frontend runs. Links in outgoing mail are built from it.
APP_BASE_URL=http://localhost:4200

# Where uploaded files land. A directory on this machine is the default so a
# fresh clone needs no object store; swap the Storage implementation in
# app/api/deps.py for S3 when there is one.
STORAGE_ROOT=var/uploads
# Stays under MAX_REQUEST_BODY_BYTES, which bounds the whole multipart body.
MAX_ATTACHMENT_BYTES=5242880
# Only these types are accepted. Anything else answers 403.
ATTACHMENT_CONTENT_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain
# log writes the whole message to the structured log, which is how you read a
# confirmation link with nothing else running. Never leave it on log in
# production: reset links would be readable by anyone who can read the logs.
# Compose overrides this to smtp and points it at Mailpit, which holds every
# message at http://127.0.0.1:8025 instead of delivering it.
MAIL_BACKEND=log
MAIL_FROM=no-reply@example.com
# Mailpit when it is running: localhost:1025 with no TLS.
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_VERIFICATION_EXPIRE_HOURS=48
# How long an account has to wait before this service sends it another link.
# It bounds what one mailbox receives however many addresses ask on its behalf.
MAIL_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRE_MINUTES=60
# Refuse a sign-in until the address is confirmed. Off by default so a fresh
# clone works without a mail server in front of it.
REQUIRE_VERIFIED_EMAIL=false

# Write demo accounts and content on `fastapi-template demo-seed --if-enabled`.
# Every account is on @example.com with the password Change!123. Local
# development only; never turn this on against a real database.
DEMO_DATA_ENABLED=false

# Identifies this service in every log line and in Grafana.
SERVICE_NAME=fastapi-template
LOG_LEVEL=INFO
# json for machines, console for a readable local stream.
LOG_FORMAT=json
# Leave unset in production: the platform collects stdout. Set it locally so
# the shared devstack repository has a file to tail.
# LOG_FILE=$HOME/.local/state/devlogs/fastapi-template.jsonl
# Serve /metrics for Prometheus.
METRICS_ENABLED=true
# Open a span per request and per query, and put trace_id on every log line, so
# one request can be followed across services. Nothing leaves the process while
# OTLP_ENDPOINT is empty.
TRACING_ENABLED=true
# Where a collector listens, for example http://localhost:4318/v1/traces.
OTLP_ENDPOINT=
# Paths that produce no access-log line, so probes and scrapes stay quiet.
REQUEST_LOG_EXCLUDED_PATHS=/health,/health/ready,/metrics
# One database row per request, for the frontend's requests screen. It costs one
# INSERT per request; turn it off if you do not need the screen.
REQUEST_LOG_PERSIST_ENABLED=true

# How long an audit row is kept, in days. scripts/prune-audit-log.py reads it.
AUDIT_LOG_RETENTION_DAYS=365

# Replay the answer to a write that carries an Idempotency-Key header instead of
# running it twice. Only an authenticated caller can reserve a key, and the key
# is scoped to that account.
IDEMPOTENCY_ENABLED=true
# How long a reserved key is remembered, in hours.
IDEMPOTENCY_RETENTION_HOURS=24
# How long a claimed key may run before a retry is allowed to take it over. It
# bounds the case where the process holding the key died mid-request.
IDEMPOTENCY_IN_FLIGHT_TIMEOUT_SECONDS=60

# Features reachable in this environment, by name. A name left out answers 404
# everywhere, so a route can ship dark. GET /api/v1/features lists them.
FEATURE_FLAGS=items,request-log,audit-log
